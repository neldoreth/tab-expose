{
  "manifest_version": 2,
  "name": "Tab Exposé",
  "version": "1.0.0",
  "description": "Vista general de pestañas al estilo Safari: todas tus pestañas en una cuadrícula animada.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "tabs",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_action": {
    "default_title": "Mostrar todas las pestañas",
    "default_icon": "icons/icon-dark.svg",
    "theme_icons": [
      {
        "light": "icons/icon-light.svg",
        "dark": "icons/icon-dark.svg",
        "size": 16
      },
      {
        "light": "icons/icon-light.svg",
        "dark": "icons/icon-dark.svg",
        "size": 32
      }
    ]
  },
  "commands": {
    "_execute_browser_action": {
      "suggested_key": {
        "default": "Alt+Shift+Space"
      },
      "description": "Mostrar todas las pestañas"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tab-expose@36228cdd83a0",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
